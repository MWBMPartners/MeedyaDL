{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "skip-changelog": true,
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "prerelease": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Improvements" },
        { "type": "refactor", "section": "Improvements" },
        { "type": "test", "section": "Improvements" },
        { "type": "chore", "section": "", "hidden": true },
        { "type": "docs", "section": "", "hidden": true },
        { "type": "ci", "section": "", "hidden": true },
        { "type": "style", "section": "", "hidden": true },
        { "type": "build", "section": "", "hidden": true }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "Project_Plan.md"
        }
      ]
    }
  }
}
