{
  // MeedyaDL markdownlint configuration
  //
  // Only suppress rules that CANNOT be fixed without degrading content:

  // Allow inline HTML — required for GitHub README centered logos, badge rows,
  // <picture> theme switching, and <strong> in descriptions
  "MD033": false,

  // Allow first line to be non-heading — README starts with centered <p> logo
  "MD041": false,

  // Disable line length — URLs, badge rows, feature descriptions, and table
  // cells naturally exceed 80 chars. Wrapping them breaks readability on GitHub.
  "MD013": false
}
